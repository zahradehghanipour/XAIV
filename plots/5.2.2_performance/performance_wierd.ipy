plot_performance(
    csv_path=IMAGENET_CSV_PATH,
    output_path=SCRIPT_DIR / "imagenet_cactus_three_way_k50176_safe.pdf",
    dataset_label="ImageNet (k=50176, safe only)",
    mode="safe",
    k_value=50176,
)


